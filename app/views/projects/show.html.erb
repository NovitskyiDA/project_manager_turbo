<turbo-frame id="project_details">
  <h2><%= @project.name %> active tasks:</h2>

  <ul id="tasks">
    <% @tasks.each do |task| %>
      <%= render partial: "tasks/task", locals: { task: task, project: @project } %>
    <% end %>
  </ul>

  <div class="pagination">
    <%= paginate @tasks, params: { turbo_frame: "project_details" } %>
  </div>

  <%= button_to "Delete Project", project_path(@project), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
</turbo-frame>
